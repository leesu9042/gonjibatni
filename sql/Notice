CREATE TABLE Notice (
    notice_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,  -- 내부 PK (자동 증가)
    notice_no INT NOT NULL,                                         -- 실제 공지 번호
    title VARCHAR(255) NOT NULL,                                    -- 공지 제목
    link VARCHAR(500),                                              -- 공지 링크
    author VARCHAR(100),                                            -- 작성자 (부서 등)
    created_at TIMESTAMP,                                           -- 등록일
    category_keyword VARCHAR(50)                                    -- 대분류 (학사행정, 장학 등)
);
